# Build output
/.build/
/build/
/.swiftpm/
DerivedData/
xcuserdata/

# Nothing compiled is checked in, and none of SIGMA Photo Pro's own files
*.dylib
*.o
/engine/sppqd
/tools/sppcap/camfdump
/tools/sppcap/x3fprobe

# Generated by tools/sppcap/mkshim.py from SPP's own dylibs
/tools/sppcap/shim95.c
/tools/sppcap/shim99.c

# Logs and half-written files
*.err
*.part

# Photos and renders
*.X3F
*.x3f
*.tif
*.tiff
*.dng
*.rgb
*.rgb16

# Fonts: tools/makeicon.swift uses Sigma's web fonts, which are not distributed
*.ttf
*.otf
*.woff
*.woff2

.DS_Store
